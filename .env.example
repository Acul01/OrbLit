# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Zotero credential encryption (server-only) ---
# Also encrypts Mendeley OAuth tokens. Generate with: openssl rand -base64 32
ZOTERO_ENCRYPTION_KEY=

# --- Mendeley OAuth (server-only) ---
# The Mendeley app form accepts one redirect URI. For orblit.io use
# https://orblit.io/api/mendeley/callback
# Defaults to NEXT_PUBLIC_APP_URL + /api/mendeley/callback.
MENDELEY_CLIENT_ID=
MENDELEY_CLIENT_SECRET=
MENDELEY_REDIRECT_URI=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: OpenAlex "polite pool" contact for higher rate limits.
# Also sent to Crossref when resolving abstracts. Server-only.
OPENALEX_MAILTO=

# Server-only. Do not prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
